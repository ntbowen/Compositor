    },
    "That profile isn’t a CMYK output profile." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该配置文件不是 CMYK 输出配置文件。"
          }
        }
      }
    },
    "That selection is too detailed to outline. Try a different Tolerance, or turn on Contiguous." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该选区过于复杂，无法勾勒轮廓。请尝试其他“容差”值，或打开“连续”。"
          }
        }
      }
    },
    "That shape is too large. A shape can cover up to %lld megapixels." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "形状过大。一个形状最多覆盖 %lld 百万像素。"
          }
        }
      }
    },
    "That text box exceeds the %@-pixel or %lld-megapixel limit." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That text box exceeds the %1$@-pixel or %2$lld-megapixel limit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该文本框超出 %1$@ 像素或 %2$lld 百万像素限制。"
          }
        }
      }
    },
    "The 2012 response. Calibration reaches most of the strength used by Version 6." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2012 年的响应曲线。校准强度达到版本 6 的大部分。"
          }
        }
      }
    },
    "The Photoshop file could not be read. It may be damaged or incomplete." : {
      "localizations" : {
        "zh-Hans" : {
